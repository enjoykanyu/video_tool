{
  "manifest_version": 3,
  "name": "B站AI双语字幕",
  "version": "2.4.0",
  "description": "为B站视频添加AI生成的中英文对照字幕，支持AI翻译与实时滚动显示",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://*.bilibili.com/*",
    "https://api.bilibili.com/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.bilibili.com/video/*",
        "https://*.bilibili.com/bangumi/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "B站AI双语字幕",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "styles.css"
      ],
      "matches": [
        "https://*.bilibili.com/*"
      ]
    }
  ]
}
